# Pitchr Environment Configuration

# Required: Google Gemini API Key for website auditing and cold outreach generation
# Get yours from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional (Recommended for 100% accurate speed & SEO): Google PageSpeed Insights API Key
# Free quota: 25,000 requests/day from https://console.cloud.google.com
GOOGLE_PAGESPEED_API_KEY=""

# Optional: Base application URL (default: http://localhost:3000)
APP_URL="http://localhost:3000"

# Optional: Supabase cloud synchronization (can also be configured via in-app UI)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional: SMTP Configuration for server-side cold email sending
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
